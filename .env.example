# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.
# Sem nenhum canal preenchido, os alertas rodam em modo simulacao.

# --- Banco de dados ------------------------------------------------------
# Senha do PostgreSQL. Use uma senha longa e aleatoria; ela so existe aqui.
POSTGRES_PASSWORD=

# --- Telegram -------------------------------------------------------------
# 1. No Telegram, fale com @BotFather, mande /newbot e siga as instrucoes.
# 2. Ele devolve o token do bot: cole abaixo.
# 3. Mande qualquer mensagem para o seu bot e abra no navegador:
#    https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
#    O numero em "chat":{"id": ...} e o seu chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord --------------------------------------------------------------
# Configuracoes do canal > Integracoes > Webhooks > Novo webhook > Copiar URL.
DISCORD_WEBHOOK_URL=

# --- Regras -----------------------------------------------------------------
# baixo, medio, alto ou critico: avisa deste nivel para cima.
ALERTA_NIVEL_MINIMO=alto
# Trava contra enxurrada: no maximo N alertas por hora em cada canal.
ALERTA_LIMITE_POR_HORA=20
# So avisa o que apareceu nas ultimas N horas (nao despeja o historico inteiro).
ALERTA_JANELA_HORAS=2
